{
  "name": "ba-spine-suite",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.2",
  "workspaces": [
    "apps/*",
    "apps/*/desktop",
    "packages/*"
  ],
  "scripts": {
    "dev:viewer": "bun --cwd=apps/viewer run desktop:dev",
    "dev:editor": "bun --cwd=apps/editor run desktop:dev",
    "build:viewer": "bun --cwd=apps/viewer run desktop:build",
    "build:editor": "bun --cwd=apps/editor run desktop:build",
    "build": "bun run build:viewer && bun run build:editor",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "bun test",
    "profile:wasm-candidates": "bun scripts/profile-wasm-candidates.ts"
  },
  "devDependencies": {
    "@types/bun": "^1.4.3",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "typescript": "^5.7.0",
    "vite": "^6.0.0"
  }
}
